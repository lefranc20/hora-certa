# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Direct connection (used by Prisma Migrate)
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Segredo usado para assinar os tokens JWT da Área Interna (login de admin/profissional)
JWT_SECRET="gere um valor aleatório, ex.: openssl rand -hex 32"
